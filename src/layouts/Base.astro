---
// The one layout. Home shows "foid.space" as the big title; other pages
// show it small above their own title, as on Windows Phone.
import '@fontsource/ibm-plex-sans/300.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import 'fluorokit/structure.css';
import 'fluorokit/themes/ink.css';
import 'fluorokit/base.css';
import '../styles/site.css';
import { enterDirectionScript } from 'fluorokit/enter';
import { NAV } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Markdown pages pass their frontmatter. */
  frontmatter?: { title?: string; description?: string };
}
const props = Astro.props;
const title = props.title ?? props.frontmatter?.title;
const description = props.description ?? props.frontmatter?.description ?? 'hub for the services running on *.foid.space';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title ? `${title} · foid.space` : 'foid.space'}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#10131d">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f6f8">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/konata-16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/konata-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon/konata-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
  <script is:inline set:html={enterDirectionScript(NAV.map((n) => n.href))} />
</head>
<body>
  <div class="shell">
    <header>
      {title ? (
        <>
          <p class="fk-overline app fk-enter"><a href="/">foid.space</a></p>
          <h1 class="fk-hero fk-enter">{title}</h1>
        </>
      ) : (
        <h1 class="fk-hero fk-enter">foid.space</h1>
      )}
      <nav class="fk-pivot fk-enter" style="--i: 1" aria-label="Site">
        {NAV.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.name}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </div>
  <script>
    // On a narrow screen the nav scrolls sideways: show the current page's header.
    const current = document.querySelector<HTMLElement>('header nav [aria-current]');
    const nav = current?.parentElement;
    if (current && nav && current.offsetLeft + current.offsetWidth > nav.clientWidth) {
      nav.scrollLeft = current.offsetLeft;
    }
  </script>
</body>
</html>
